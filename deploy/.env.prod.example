# -----------------------------------------------------------------------------
# Configuration PRODUCTION - redcross.clixite-prod.cloud
# Copier vers .env et remplacer les valeurs par des secrets forts (openssl rand -hex 24)
# -----------------------------------------------------------------------------

# Domaine public du portail
FRONTEND_URL=https://redcross.clixite-prod.cloud

# Base de données PostgreSQL
POSTGRES_USER=sfs_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=sfs_portail

# MinIO (stockage objets / pièces jointes)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
S3_BUCKET=sfs-portal-attachments

# Sécurité JWT (min. 32 caractères)
JWT_SECRET=CHANGE_ME_STRONG_AT_LEAST_32_CHARS

# Intégration Qualios (mock en production pour la démo)
QUALIOS_API_KEY=CHANGE_ME_STRONG
