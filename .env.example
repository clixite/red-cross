# -----------------------------------------------------------------------------
# Configuration Générale - Portail Clients Service du Sang
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000
MOCK_QUALIOS_PORT=4010

# URL Publique du Frontend
FRONTEND_URL=http://localhost:3000

# Base de Données PostgreSQL
DATABASE_URL=postgresql://sfs_user:sfs_secure_pass_2025@localhost:5432/sfs_portail?schema=public

# Stockage Objets S3 / MinIO (Pièces jointes, documents contrôlés)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=sfs-portal-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# Sécurité & Tokens JWT
JWT_SECRET=super-secret-jwt-key-for-sfs-portal-at-least-32-chars-long!
JWT_EXPIRES_IN=8h
INVITATION_TOKEN_EXPIRES_IN_HOURS=72

# Intégration Qualios
# Options: 'manual' (défaut démo), 'rest' (API REST Qualios), 'file' (échange fichiers SFTP/réseau)
QUALIOS_ADAPTER=rest
QUALIOS_BASE_URL=http://localhost:4010/api/v1
QUALIOS_API_KEY=qualios_live_secret_key_sfs_demo
QUALIOS_FILE_EXCHANGE_PATH=./data/qualios_exchange
QUALIOS_SYNC_INTERVAL_SEC=15

# Notifications & E-mails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Service du Sang - Qualité <qualite-service-du-sang@croix-rouge-demo.be>"
EMAIL_SIMULATION_MODE=true

# Service Antivirus
ANTIVIRUS_ENABLED=true
ANTIVIRUS_MOCK_MODE=true

# SLA Délais (en heures / jours)
SLA_RECEVABILITE_HOURS=16
SLA_REPONSE_FINALE_DAYS=30
